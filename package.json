{
  "name": "custom-chess-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "npm run build:engine && vite build",
    "build:client": "vite build",
    "build:engine": "cmake -S engine -B engine/build && cmake --build engine/build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:web": "npm run build:wasm && vite build",
    "test": "npm run test:engine",
    "test:engine": "cmake -S engine -B engine/build && cmake --build engine/build && ./engine/build/engine_tests",
    "bench:engine": "cmake -S engine -B engine/build -DCMAKE_BUILD_TYPE=Release && cmake --build engine/build --config Release && ./engine/build/engine_bench"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-chessboard": "^5.5.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  }
}
